{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Self-hosted app plus Google Fonts and Google sign-in; inline styles come from React style props and Google's button.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.googleusercontent.com; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	request_body {
		max_size 11MB
	}

	# /api keeps its prefix, so unknown API paths stay JSON errors instead of HTML.
	handle /api* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# Hashed build assets never change; the HTML entry point must always revalidate.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/* /media/* /favicon.svg
		header @pages Cache-Control "no-cache"
		@media path /media/*
		header @media Cache-Control "public, max-age=604800"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
