# Copy to deploy/.env.production (git-ignored) on the server; deploy/setup.sh fills in every
# secret with fresh random values. Never commit the real file. Back it up with the
# database: losing MFA_ENCRYPTION_KEY voids every two-step enrolment.

# Public hostname. With no domain, <public-ip-with-dashes>.sslip.io resolves to the VM and
# still gets a Let's Encrypt certificate, e.g. 129-151-10-20.sslip.io
APP_DOMAIN=

ENVIRONMENT=production
APP_NAME=JobBridge

POSTGRES_USER=jobbridge
POSTGRES_DB=jobbridge
POSTGRES_PASSWORD=
NEO4J_PASSWORD=

JWT_SECRET=
JWT_EXPIRE_MINUTES=60
MFA_ENCRYPTION_KEY=
MFA_REQUIRED_ROLES=["admin"]

# Password for the seeded demo accounts on this host (not the one published in the repo).
SEED_PASSWORD=

# Optional Sign in with Google: add https://<APP_DOMAIN> to the OAuth client's
# Authorised JavaScript origins first.
# GOOGLE_CLIENT_ID=
# GOOGLE_SIGNIN_EMAILS=["someone@gmail.com"]

GRAPH_SYNC_INTERVAL_SECONDS=5
PRELOAD_MATCHING_MODEL=true

# Neo4j memory; the defaults suit a 6-12 GB VM.
NEO4J_HEAP=1g
NEO4J_PAGECACHE=512m
