APP_NAME=Hybrid Workforce Placement Engine
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

POSTGRES_USER=workforce
POSTGRES_PASSWORD=workforce
POSTGRES_DB=workforce
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://workforce:workforce@localhost:5433/workforce

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=workforce-password

# Staging/production rejects this default or a JWT_SECRET shorter than 32 characters.
# Shared deployments also require explicit HTTPS CORS_ORIGINS. Never commit .env.
JWT_SECRET=replace-this-development-secret-before-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
