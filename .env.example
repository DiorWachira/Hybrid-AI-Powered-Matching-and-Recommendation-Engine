APP_NAME=Hybrid Workforce Placement Engine
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

POSTGRES_USER=workforce
POSTGRES_PASSWORD=workforce
POSTGRES_DB=workforce
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://workforce:workforce@localhost:5433/workforce

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=workforce-password

# Staging/production rejects this default or a JWT_SECRET shorter than 32 characters.
# Shared deployments also require explicit HTTPS CORS_ORIGINS. Never commit .env.
JWT_SECRET=replace-this-development-secret-before-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Two-step verification (authenticator-app TOTP). Listed roles must enrol before signing in.
MFA_REQUIRED_ROLES=["admin"]
# Fernet key that encrypts stored TOTP secrets. Required in staging/production; development
# derives one from JWT_SECRET when unset (changing JWT_SECRET then voids existing enrolments).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MFA_ENCRYPTION_KEY=

# "Sign in with Google" (optional). Off while GOOGLE_CLIENT_ID is empty. Create an OAuth client of type
# "Web application" in Google Cloud Console with your site origin (e.g. http://localhost:5173) under
# "Authorised JavaScript origins". Only existing, non-admin accounts listed below may use it.
# GOOGLE_CLIENT_ID=
# GOOGLE_SIGNIN_EMAILS=["someone@gmail.com"]

# Seconds between in-process PostgreSQL -> Neo4j graph syncs; 0 disables the worker.
# GRAPH_SYNC_INTERVAL_SECONDS=5

# Password for seeded demo accounts (seed_database.py, seed_oversight_demo.py).
# Leave unset locally; set a unique value before seeding a shared or public demo.
# SEED_PASSWORD=
